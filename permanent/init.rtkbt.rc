# Permanent Realtek USB Bluetooth (RTL8761B 0bda:8771)
# Device node /dev/rtkbt_dev is labeled bluetooth_device via vendor_file_contexts

on post-fs-data
    mkdir /data/misc/bluedroid 0770 bluetooth bluetooth
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth

on boot
    insmod /vendor/lib/modules/rtk_btusb.ko
    wait /dev/rtkbt_dev 8
    chmod 0660 /dev/rtkbt_dev
    chown bluetooth bluetooth /dev/rtkbt_dev
    restorecon /dev/rtkbt_dev
    restart vendor.bluetooth-1-0

on property:sys.boot_completed=1
    # Re-apply label/perms if USB probe raced after boot
    chmod 0660 /dev/rtkbt_dev
    chown bluetooth bluetooth /dev/rtkbt_dev
    restorecon /dev/rtkbt_dev
